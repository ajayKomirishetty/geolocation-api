# Obtain an access key from https://ipstack.com/.
IPSTACK_API_KEY=replace-with-your-ipstack-key

# Generate a long, random value, for example: `openssl rand -hex 32`.
API_TOKEN=replace-with-a-long-random-bearer-token

# Generate with: `openssl rand -hex 64`.
SECRET_KEY_BASE=replace-with-a-long-random-rails-secret
